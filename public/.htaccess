# On shared hosting this folder usually sits inside the main website's folder (a subdomain
# does), and that site's URL rules would otherwise apply here too and send the CRM's pages
# to the website's 404. Turning the engine on in this folder makes its rules the only ones.
<IfModule mod_rewrite.c>
  RewriteEngine On
</IfModule>

DirectoryIndex index.html index.php

# No folder listings.
<IfModule mod_autoindex.c>
  IndexIgnore *
</IfModule>

# Only pages, scripts and styles are meant to be opened directly.
<FilesMatch "\.(md|sqlite|sqlite-journal|log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Pages, scripts and styles are always checked against the server before use, so nobody
  # keeps working with an old copy after an update. (The API sets its own, stricter header.)
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
